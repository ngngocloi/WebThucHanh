@model BE_0302.Models.Order
@using BE_0302.Helpers
@{ ViewBag.Title = "Thông tin đơn hàng #" + Model.OrderID; Layout = "~/Views/Shared/_CustomerLayout.cshtml"; }
<div class="orders-page"><h1>Đơn hàng #@Model.OrderID</h1><div class="order-detail-grid">
<section class="order-summary"><h2>THÔNG TIN ĐƠN HÀNG</h2><dl>
<dt>Ngày đặt hàng</dt><dd>@Model.OrderDate.ToString("dd/MM/yyyy")</dd><dt>Trạng thái đơn</dt><dd>@OrderWorkflow.Label(Model.OrderStatus)</dd>
<dt>Thanh toán</dt><dd>@OrderWorkflow.PaymentLabel(Model.PaymentStatus)</dd><dt>Phương thức thanh toán</dt><dd>@Model.PaymentMethod</dd>
<dt>Phương thức giao hàng</dt><dd>@Model.DeliveryMethod</dd><dt>Địa chỉ nhận hàng</dt><dd>@Model.ShippingAddress</dd>
<dt>Tổng giá trị</dt><dd>@Model.TotalAmount.ToString("N0") đ</dd>
</dl></section><section>@Html.Partial("~/Views/Shared/_OrderLines.cshtml", Model.OrderDetails)</section></div>
<a class="btn btn-primary" href="@Url.Action("MyOrder")">Lịch sử mua hàng</a><a class="btn btn-default" href="@Url.Action("Index", "Home")">Tiếp tục mua sắm</a></div>
