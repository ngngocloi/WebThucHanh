@model BE_0302.Models.Order

@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    .order-success-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 32px;
        margin: 20px auto 40px auto;
        max-width: 860px;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    }
    .success-header-badge {
        text-align: center;
        padding-bottom: 24px;
        border-bottom: 1px dashed #e2e8f0;
        margin-bottom: 24px;
    }
    .success-icon-circle {
        width: 72px;
        height: 72px;
        background: #dcfce7;
        color: #16a34a;
        font-size: 36px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
    }
    .success-header-badge h2 {
        font-size: 26px;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 8px 0;
    }
    .order-meta-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 14px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 24px;
    }
    .order-meta-item span {
        display: block;
        font-size: 12.5px;
        color: #64748b;
        margin-bottom: 3px;
    }
    .order-meta-item strong {
        font-size: 14.5px;
        color: #0f172a;
    }
</style>

<div class="order-success-card">
    <div class="success-header-badge">
        <div class="success-icon-circle">
            <i class="fas fa-check"></i>
        </div>
        <h2>ĐẶT HÀNG THÀNH CÔNG!</h2>
        <p style="color: #64748b; font-size: 15px; margin: 0;">
            Cảm ơn bạn đã mua sắm tại FASTOR E-Commerce. Đơn hàng của bạn đã được tiếp nhận và xử lý.
        </p>
    </div>

    <div class="order-meta-grid">
        <div class="order-meta-item">
            <span>Mã đơn hàng:</span>
            <strong class="text-primary">#@Model.OrderID</strong>
        </div>
        <div class="order-meta-item">
            <span>Ngày đặt hàng:</span>
            <strong>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</strong>
        </div>
        <div class="order-meta-item">
            <span>Trạng thái thanh toán:</span>
            <strong class="text-success"><i class="fas fa-check-circle"></i> @Model.PaymentStatus</strong>
        </div>
        <div class="order-meta-item">
            <span>Phương thức thanh toán:</span>
            <strong>@(string.IsNullOrEmpty(Model.PaymentMethod) ? "Tiền mặt" : Model.PaymentMethod)</strong>
        </div>
        <div class="order-meta-item" style="grid-column: 1 / -1;">
            <span>Địa chỉ nhận hàng:</span>
            <strong><i class="fas fa-map-marker-alt text-danger"></i> @(Model.AddressDelivery ?? Model.ShippingAddress)</strong>
        </div>
    </div>

    <h3 style="font-size: 17px; font-weight: 800; color: #1e293b; margin-bottom: 14px;">
        <i class="fas fa-list-ul"></i> Chi tiết các mặt hàng đã đặt
    </h3>

    <div class="table-responsive">
        <table class="table table-bordered table-hover" style="vertical-align: middle;">
            <thead>
                <tr style="background:#f1f5f9; font-size:13px; color:#475569;">
                    <th colspan="2">Sản phẩm</th>
                    <th class="text-center">Số lượng</th>
                    <th>Đơn giá</th>
                    <th class="text-right">Tổng giá</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    <tr>
                        <td style="width: 60px;">
                            <img src="@Url.Content(item.Product != null ? item.Product.ImageUrl : "~/Content/images/default-product.svg")"
                                 alt=""
                                 style="width: 50px; height: 50px; object-fit: contain; border-radius: 4px;"
                                 onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/default-product.svg")';" />
                        </td>
                        <td>
                            <strong>@(item.Product != null ? item.Product.ProductName : "Sản phẩm #" + item.ProductID)</strong>
                        </td>
                        <td class="text-center">
                            <span class="badge" style="background:#e2e8f0; color:#0f172a;">x @item.Quantity</span>
                        </td>
                        <td>@item.UnitPrice.ToString("N0") đ</td>
                        <td class="text-right" style="font-weight:700; color:#dc2626;">
                            @((item.TotalPrice ?? (item.Quantity * item.UnitPrice)).ToString("N0")) đ
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="background:#f8fafc; font-size:16px;">
                    <td colspan="4" class="text-right"><strong>Tổng tiền thanh toán:</strong></td>
                    <td class="text-right" style="font-weight:900; color:#dc2626; font-size:18px;">
                        @Model.TotalAmount.ToString("N0") đ
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div style="text-align: center; margin-top: 30px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="@Url.Action("Index", "Home")" class="btn btn-warning" style="font-weight:700; padding:10px 24px; border-radius:8px;">
            <i class="fas fa-home"></i> Trở về Trang chủ
        </a>
        <a href="@Url.Action("OrderHistory", "Order")" class="btn btn-default" style="font-weight:600; padding:10px 24px; border-radius:8px;">
            <i class="fas fa-history"></i> Xem lịch sử đơn hàng
        </a>
    </div>
</div>
