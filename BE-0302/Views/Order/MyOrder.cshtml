@model BE_0302.Models.ViewModel.OrderHistoryVM
@using BE_0302.Helpers
@{ ViewBag.Title = "Đơn hàng của tôi"; Layout = "~/Views/Shared/_CustomerLayout.cshtml"; }
<div class="orders-page"><h1>Đơn hàng của tôi</h1>
<nav class="order-tabs" aria-label="Trạng thái đơn hàng">
    <a class="@(Model.Status == "All" ? "active" : "")" href="@Url.Action("MyOrder", new { searchTerm = Model.SearchTerm })">Tất cả đơn</a>
    @foreach (var state in OrderWorkflow.States) { <a class="@(Model.Status == state ? "active" : "")" href="@Url.Action("MyOrder", new { status = state, searchTerm = Model.SearchTerm })">@OrderWorkflow.Label(state)</a> }
</nav>
@using (Html.BeginForm("MyOrder", "Order", FormMethod.Get, new { @class = "order-search" })) {
    <input type="hidden" name="status" value="@Model.Status" /><label class="sr-only" for="order-keyword">Tìm đơn hàng</label>
    <input id="order-keyword" name="searchTerm" value="@Model.SearchTerm" maxlength="200" placeholder="Tìm đơn hàng theo mã đơn hàng hoặc tên sản phẩm" /><button type="submit">Tìm đơn hàng</button>
}
@if (!Model.HasAnyOrders) {
    <div class="orders-empty"><h2>BẠN CHƯA CÓ ĐƠN HÀNG NÀO. HÃY ĐẶT ĐƠN NGAY.</h2><a class="btn btn-primary" href="@Url.Action("Index", "Home")">Về trang HOME</a></div>
} else if (Model.Groups.Count == 0) {
    <div class="orders-empty"><h2>Không tìm thấy đơn hàng phù hợp.</h2><a href="@Url.Action("MyOrder")">Xem tất cả đơn hàng</a></div>
} else {
    foreach (var group in Model.Groups) {
        <section class="order-group"><div class="order-count"><h2>@OrderWorkflow.Label(group.Status)</h2><span>Hiển thị @group.Orders.Count / @group.TotalCount đơn</span></div>
        @foreach (var order in group.Orders) {
            <article class="purchase-card" data-order-id="@order.OrderID"><header><span class="order-state state-@group.Status">@OrderWorkflow.Label(group.Status)</span><span>#@order.OrderID · @order.OrderDate.ToString("dd/MM/yyyy")</span></header>
            @foreach (var line in order.OrderDetails.OrderBy(d => d.ID)) {
                <div class="purchase-line">
                @if (line.Product != null) {
                    <a href="@Url.Action("ProductDetails", "Home", new { id = line.ProductID })"><img src="@Url.Content(line.Product.ImageUrl)" alt="@line.Product.ProductName" onerror="this.onerror=null;this.src='@Url.Content(line.Product.FallbackImageUrl)';" /></a>
                    <div class="purchase-info"><a class="purchase-name" href="@Url.Action("ProductDetails", "Home", new { id = line.ProductID })">@line.Product.ProductName</a><p>Số lượng: @line.Quantity · Đơn giá: @line.UnitPrice.ToString("N0") đ</p><div class="purchase-actions">
                    @using (Html.BeginForm("Reorder", "Order", new { id = order.OrderID, productId = line.ProductID }, FormMethod.Post, new { @class = "inline-form" })) { @Html.AntiForgeryToken()<button type="submit" class="btn btn-default btn-sm">Mua lại</button> }
                    <a class="btn btn-default btn-sm" href="@Url.Action("ProductDetails", "Home", new { id = line.ProductID })">Xem chi tiết</a></div></div>
                } else { <div class="purchase-info">Sản phẩm không còn được bán</div> }
                <strong class="purchase-price">@line.TotalPrice.ToString("N0") đ</strong></div>
            }
            <footer><span>@OrderWorkflow.PaymentLabel(order.PaymentStatus)</span><div>Tổng tiền: <strong>@order.TotalAmount.ToString("N0") đ</strong><div class="purchase-actions">
                @using (Html.BeginForm("Reorder", "Order", new { id = order.OrderID }, FormMethod.Post, new { @class = "inline-form" })) { @Html.AntiForgeryToken()<button type="submit" class="btn btn-primary">Mua lại đơn này</button> }
                <a class="btn btn-default" href="@Url.Action("OrderSuccess", new { id = order.OrderID })">Thông tin đơn hàng</a>
            </div></div></footer></article>
        }
        @if (group.TotalCount > 2 && !group.Expanded) { <a class="more-orders" href="@Url.Action("MyOrder", new { status = Model.Status, searchTerm = Model.SearchTerm, more = group.Status })">Xem thêm · tối đa 50 đơn gần nhất</a> }
        @if (group.Expanded) { <div class="order-count"><span>Đang hiển thị tối đa 50 đơn gần nhất.</span><a href="@Url.Action("MyOrder", new { status = Model.Status, searchTerm = Model.SearchTerm })">Thu gọn</a></div> }
        </section>
    }
}
</div>
