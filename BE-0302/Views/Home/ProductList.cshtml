@model BE_0302.Models.ViewModel.HomeProductVM
@using PagedList.Mvc
@{ ViewBag.Title = ViewBag.CategoryName ?? "Danh sách sản phẩm"; Layout = "~/Views/Shared/_CustomerLayout.cshtml"; }
<div class="orders-page"><h1>@ViewBag.Title</h1>
@using (Html.BeginForm("ProductList", "Home", FormMethod.Get, new { @class = "order-filters search-form" })) {
    <input type="hidden" name="id" value="@ViewBag.CategoryID" />
    <div><label for="SearchTerm">Tìm kiếm</label>@Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control", placeholder = "Tên, mô tả hoặc danh mục", maxlength = 200 })</div>
    <div><label for="SortOrder">Sắp xếp</label>@Html.DropDownListFor(m => m.SortOrder, new[] {
        new SelectListItem { Value = "", Text = "Mới nhất" }, new SelectListItem { Value = "name", Text = "Tên A–Z" }, new SelectListItem { Value = "name_desc", Text = "Tên Z–A" },
        new SelectListItem { Value = "price", Text = "Giá tăng dần" }, new SelectListItem { Value = "price_desc", Text = "Giá giảm dần" }
    }, new { @class = "form-control" })</div><button class="btn btn-primary" type="submit">Tìm kiếm</button>
}
<p>@Model.NewProducts.TotalItemCount sản phẩm · 6 sản phẩm/trang</p>
@if (Model.NewProducts.Count == 0) { <div class="orders-empty">Không có sản phẩm phù hợp.</div> }
<div class="order-product-grid">@foreach (var p in Model.NewProducts) { @Html.Partial("~/Views/Shared/_ProductCard.cshtml", p) }</div>
@Html.PagedListPager(Model.NewProducts, page => Url.Action("ProductList", new { id = ViewBag.CategoryID, searchTerm = Model.SearchTerm, sortOrder = Model.SortOrder, page }))
</div>
