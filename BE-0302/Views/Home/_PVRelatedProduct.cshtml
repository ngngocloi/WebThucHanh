@model BE_0302.Models.ViewModel.ProductDetailsVM
@if (Model.RelatedProducts != null && Model.RelatedProducts.Count > 0) {
    <div class="related-product-rail" tabindex="0" aria-label="Sản phẩm cùng danh mục">@foreach (var p in Model.RelatedProducts) { @Html.Partial("~/Views/Shared/_ProductCard.cshtml", p) }</div>
} else { <p>Chưa có sản phẩm cùng danh mục.</p> }
