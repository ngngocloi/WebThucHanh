@model BE_0302.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc
@if (Model.TopProducts != null && Model.TopProducts.Count > 0) {
    <div class="order-product-grid">@foreach (var p in Model.TopProducts) { @Html.Partial("~/Views/Shared/_ProductCard.cshtml", p) }</div>
    @Html.PagedListPager(Model.TopProducts, page => Url.Action("ProductDetails", new { id = Model.product.ProductID, quantity = Model.quantity, page }))
} else { <p>Chưa có sản phẩm bán chạy cùng danh mục.</p> }
