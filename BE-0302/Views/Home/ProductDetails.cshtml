@model BE_0302.Models.ViewModel.ProductDetailsVM
@{ ViewBag.Title = Model.product.ProductName; Layout = "~/Views/Shared/_CustomerLayout.cshtml"; }
<div class="orders-page">
<nav class="breadcrumb"><a href="@Url.Action("Index")">Trang chủ</a> / <a href="@Url.Action("ProductList", new { id = Model.product.CategoryID })">@Model.product.Category.CategoryName</a> / Chi tiết sản phẩm</nav>
<section class="purchase-card product-detail-panel"><img class="detail-photo" src="@Url.Content(Model.product.ImageUrl)" alt="@Model.product.ProductName" onerror="this.onerror=null;this.src='@Url.Content(Model.product.FallbackImageUrl)';" />
<div><h1>@Model.product.ProductName</h1><p class="text-muted">@Model.product.Category.CategoryName</p><strong class="detail-price">@Model.product.ProductPrice.ToString("N0") đ</strong>
<p>Đã bán: @Model.product.OrderDetails.Where(d => d.Order.OrderStatus != "Cancelled").Sum(d => d.Quantity) sản phẩm</p><p class="detail-description">@Model.product.ProductDescription</p>
@using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post)) {
    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.product.ProductID" />
    <label for="detail-qty">Số lượng</label><input id="detail-qty" type="number" name="quantity" value="@Model.quantity" min="1" max="99" required data-price="@Model.product.ProductPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
    <p>Tạm tính: <strong id="detail-estimate">@Model.estimatedValue.ToString("N0") đ</strong></p>
    <button type="submit" class="btn btn-primary btn-lg">Thêm vào giỏ hàng</button><a class="btn btn-default" href="@Url.Action("Index", "Cart")">Xem giỏ hàng</a>
}
</div></section>
<h2>Sản phẩm cùng danh mục</h2>@Html.Partial("_PVRelatedProduct", Model)
<h2>Top Deals · Bán chạy cùng danh mục</h2>@Html.Partial("_PVTopProduct", Model)
</div>
@section scripts {
<script>
(function () {
    var qty = document.getElementById('detail-qty');
    qty.addEventListener('input', function () { document.getElementById('detail-estimate').textContent = new Intl.NumberFormat('vi-VN').format(Number(qty.value) * Number(qty.getAttribute('data-price'))) + ' đ'; });
}());
</script>
}
