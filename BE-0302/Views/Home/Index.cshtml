@model BE_0302.Models.ViewModel.HomeProductVM
@{
    ViewBag.Title = "Trang chủ mua sắm trực tuyến";
    var categories = ViewBag.Categories as IEnumerable<BE_0302.Models.Category>;
    int? activeCategoryId = ViewBag.CategoryID as int?;
}
<link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/myStyle/CustomerHome.css")" />

<section id="topBanner" class="container-fluid banner">
    <div class="banner-container">
        <span class="banner-pill"><i class="fas fa-bolt"></i> SIÊU SALE CÔNG NGHỆ &amp; SÁCH LẬP TRÌNH</span>
        <h2>Chào mừng đến trang web E-commerce FASTOR</h2>
        <p>Mua sắm trực tuyến với hàng ngàn sản phẩm đa dạng, hình ảnh thực tế và giao diện cuộn mượt mà</p>
        <div class="banner-actions">
            <a href="#searchProd" class="btnBanner"><i class="fas fa-search"></i> Bắt đầu mua sắm</a>
            <a href="#featureProd" class="btnBannerSecondary"><i class="fas fa-fire"></i> Xem sản phẩm nổi bật</a>
        </div>
    </div>
</section>

<section id="searchProd" class="container-fluid searchProd">
    <h2><i class="fas fa-compass"></i> Tìm kiếm &amp; Chọn nhanh Danh mục</h2>
    @using (Html.BeginForm("Index", "Home", FormMethod.Get))
    {
        if (activeCategoryId.HasValue)
        {
            <input type="hidden" name="categoryId" value="@activeCategoryId.Value" />
        }
        <div class="form-group search-container">
            @Html.TextBoxFor(m => m.SearchTerm, new
            {
                @class = "search-input",
                placeholder = "Nhập tên sản phẩm (VD: iPhone 15 Pro, MacBook, Sony, Sách ASP.NET MVC...)"
            })
            <button type="submit" class="search-button">
                <i class="fas fa-search"></i> Tìm kiếm
            </button>
        </div>
    }

    @if (categories != null && categories.Any())
    {
        <div class="category-pills-bar" role="navigation" aria-label="Chọn nhanh danh mục">
            <a href="@Url.Action("Index", "Home", new { categoryId = (int?)null, searchTerm = Model.SearchTerm })"
               class="category-pill @(!activeCategoryId.HasValue ? "active" : "")">
                <i class="fas fa-border-all"></i> Tất cả sản phẩm
            </a>
            @foreach (var cat in categories)
            {
                string catLower = (cat.CategoryName ?? "").ToLowerInvariant();
                string pillIcon = "fa-tag";
                if (catLower.Contains("công nghệ")) { pillIcon = "fa-laptop-code"; }
                else if (catLower.Contains("sách")) { pillIcon = "fa-book-open"; }
                else if (catLower.Contains("âm thanh") || catLower.Contains("phụ kiện")) { pillIcon = "fa-headphones-alt"; }

                <a href="@Url.Action("Index", "Home", new { categoryId = cat.CategoryID, searchTerm = Model.SearchTerm })"
                   class="category-pill @(activeCategoryId == cat.CategoryID ? "active" : "")">
                    <i class="fas @pillIcon"></i> @cat.CategoryName
                </a>
            }
        </div>
    }
</section>

@Html.Partial("_PVFeatureProduct", Model)

@Html.Partial("_PVNewProduct", Model)
