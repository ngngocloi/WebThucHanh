@model BE_0302.Models.ViewModel.RegisterVM

@{
    ViewBag.Title = "Đăng ký thành viên";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container" style="max-width: 680px; margin-top: 25px; margin-bottom: 50px;">
    <div class="auth-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 32px; box-shadow: 0 4px 20px rgba(15,23,42,0.06);">
        <div style="text-align: center; margin-bottom: 24px;">
            <div style="width: 56px; height: 56px; background: #dbeafe; color: #2563eb; font-size: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                <i class="fas fa-user-plus"></i>
            </div>
            <h2 style="font-weight: 800; font-size: 24px; color: #0f172a; margin: 0 0 6px 0;">ĐĂNG KÝ THÀNH VIÊN</h2>
            <p style="color: #64748b; font-size: 13.5px; margin: 0;">Tạo tài khoản khách hàng để trải nghiệm mua sắm tuyệt vời tại FASTOR</p>
        </div>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", style = "font-size:13.5px; border-radius:8px;" })

            <h4 style="font-size: 15px; font-weight: 700; color: #1e293b; border-bottom: 2px solid #f1f5f9; padding-bottom: 8px; margin-bottom: 16px;">
                <i class="fas fa-shield-alt text-primary"></i> 1. Thông tin đăng nhập
            </h4>

            <div class="form-group" style="margin-bottom: 16px;">
                <label for="Username" style="font-weight: 700; font-size: 13.5px; color: #334155;">
                    Tên đăng nhập <span class="text-danger">*</span>:
                </label>
                @Html.TextBoxFor(m => m.Username, new
                {
                    @class = "form-control",
                    placeholder = "Chọn tên đăng nhập (từ 3 ký tự)...",
                    style = "height: 42px; border-radius: 8px;"
                })
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger", style = "font-size:12px;" })
            </div>

            <div class="row">
                <div class="col-md-6 col-sm-12">
                    <div class="form-group" style="margin-bottom: 16px;">
                        <label for="Password" style="font-weight: 700; font-size: 13.5px; color: #334155;">
                            Mật khẩu <span class="text-danger">*</span>:
                        </label>
                        @Html.PasswordFor(m => m.Password, new
                        {
                            @class = "form-control",
                            placeholder = "Tối thiểu 8 ký tự...",
                            style = "height: 42px; border-radius: 8px;"
                        })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger", style = "font-size:12px;" })
                    </div>
                </div>
                <div class="col-md-6 col-sm-12">
                    <div class="form-group" style="margin-bottom: 16px;">
                        <label for="ConfirmPassword" style="font-weight: 700; font-size: 13.5px; color: #334155;">
                            Xác nhận mật khẩu <span class="text-danger">*</span>:
                        </label>
                        @Html.PasswordFor(m => m.ConfirmPassword, new
                        {
                            @class = "form-control",
                            placeholder = "Nhập lại mật khẩu...",
                            style = "height: 42px; border-radius: 8px;"
                        })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger", style = "font-size:12px;" })
                    </div>
                </div>
            </div>

            <h4 style="font-size: 15px; font-weight: 700; color: #1e293b; border-bottom: 2px solid #f1f5f9; padding-bottom: 8px; margin-top: 20px; margin-bottom: 16px;">
                <i class="fas fa-id-card text-success"></i> 2. Thông tin cá nhân khách hàng
            </h4>

            <div class="form-group" style="margin-bottom: 16px;">
                <label for="CustomerName" style="font-weight: 700; font-size: 13.5px; color: #334155;">
                    Họ và tên khách hàng <span class="text-danger">*</span>:
                </label>
                @Html.TextBoxFor(m => m.CustomerName, new
                {
                    @class = "form-control",
                    placeholder = "Ví dụ: Nguyễn Văn A...",
                    style = "height: 42px; border-radius: 8px;"
                })
                @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger", style = "font-size:12px;" })
            </div>

            <div class="row">
                <div class="col-md-6 col-sm-12">
                    <div class="form-group" style="margin-bottom: 16px;">
                        <label for="CustomerPhone" style="font-weight: 700; font-size: 13.5px; color: #334155;">
                            Số điện thoại liên hệ <span class="text-danger">*</span>:
                        </label>
                        @Html.TextBoxFor(m => m.CustomerPhone, new
                        {
                            @class = "form-control",
                            placeholder = "Ví dụ: 0901234567...",
                            style = "height: 42px; border-radius: 8px;"
                        })
                        @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "text-danger", style = "font-size:12px;" })
                    </div>
                </div>
                <div class="col-md-6 col-sm-12">
                    <div class="form-group" style="margin-bottom: 16px;">
                        <label for="CustomerEmail" style="font-weight: 700; font-size: 13.5px; color: #334155;">
                            Địa chỉ Email <span class="text-danger">*</span>:
                        </label>
                        @Html.TextBoxFor(m => m.CustomerEmail, new
                        {
                            @class = "form-control",
                            placeholder = "Ví dụ: khachhang@email.com...",
                            style = "height: 42px; border-radius: 8px;"
                        })
                        @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-danger", style = "font-size:12px;" })
                    </div>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 24px;">
                <label for="CustomerAddress" style="font-weight: 700; font-size: 13.5px; color: #334155;">
                    Địa chỉ nhận hàng mặc định <span class="text-danger">*</span>:
                </label>
                @Html.TextAreaFor(m => m.CustomerAddress, new
                {
                    @class = "form-control",
                    rows = 2,
                    placeholder = "Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố...",
                    style = "border-radius: 8px;"
                })
                @Html.ValidationMessageFor(m => m.CustomerAddress, "", new { @class = "text-danger", style = "font-size:12px;" })
            </div>

            <button type="submit" class="btn btn-primary btn-block" style="height: 46px; font-weight: 800; font-size: 15px; border-radius: 8px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); border: none; box-shadow: 0 4px 12px rgba(37,99,235,0.35);">
                <i class="fas fa-check-circle"></i> ĐĂNG KÝ TÀI KHOẢN NGAY
            </button>
        }

        <div style="text-align: center; margin-top: 22px; padding-top: 18px; border-top: 1px dashed #e2e8f0; font-size: 13.5px; color: #64748b;">
            Đã có tài khoản?
            <a href="@Url.Action("Login", "Account")" style="font-weight: 700; color: #dc2626; text-decoration: none;">
                Đăng nhập tại đây
            </a>
        </div>
    </div>
</div>
