@model BE_0302.Models.ViewModel.Cart
@{ ViewBag.Title = "Giỏ hàng"; Layout = "~/Views/Shared/_CustomerLayout.cshtml"; }
<div class="orders-page"><h1>Giỏ hàng của bạn</h1>
@if (!Model.Items.Any()) {
    <div class="orders-empty"><h2>Giỏ hàng đang trống.</h2><a class="btn btn-primary" href="@Url.Action("Index", "Home")">Tiếp tục mua hàng</a></div>
} else {
    <div class="cart-columns"><section>
    @foreach (var group in Model.GroupedItems) {
        <div class="purchase-card"><h2 class="cart-category-title">@group.Key</h2>
        @foreach (var item in group) {
            <div class="purchase-line">
                <input type="checkbox" form="cart-selection" name="selectedIds" value="@item.ProductID" checked="@(item.Selected ? "checked" : null)" data-cart-select data-total="@item.TotalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="Chọn mua @item.ProductName" />
                <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })"><img src="@Url.Content(item.ImageUrl)" alt="@item.ProductName" onerror="this.onerror=null;this.src='@Url.Content(BE_0302.Models.SampleImageHelper.ResolveLocalFallback(item.ProductID, item.ProductName))';" /></a>
                <div class="purchase-info"><a class="purchase-name" href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })">@item.ProductName</a><p>@item.UnitPrice.ToString("N0") đ / sản phẩm</p>
                @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "cart-quantity" })) {
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.ProductID" /><label class="sr-only" for="qty-@item.ProductID">Số lượng</label>
                    <input id="qty-@item.ProductID" type="number" min="1" max="99" name="quantity" value="@item.Quantity" required /><button type="submit" class="btn btn-default btn-sm">Cập nhật</button>
                }
                </div><div><strong>@item.TotalPrice.ToString("N0") đ</strong>
                    @using (Html.BeginForm("RemoveFromCart", "Cart", FormMethod.Post)) {
                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.ProductID" /><button type="submit" class="btn btn-link text-danger">Xóa</button>
                    }
                </div>
            </div>
        }
        </div>
    }
    @using (Html.BeginForm("ClearCart", "Cart", FormMethod.Post)) { @Html.AntiForgeryToken()<button type="submit" class="btn btn-default">Xóa hết giỏ hàng</button> }
    </section><aside class="cart-total-box"><h2>Tính tiền</h2><p>Chọn các sản phẩm bạn muốn mua.</p><p>Tạm tính: <strong id="cart-selected-total"></strong></p>
        @using (Html.BeginForm("Checkout", "Cart", FormMethod.Post, new { id = "cart-selection" })) { @Html.AntiForgeryToken()<button type="submit" class="btn btn-primary btn-block">Mua hàng đã chọn</button> }
        <a class="btn btn-default btn-block" href="@Url.Action("Index", "Home")">Tiếp tục mua hàng</a>
    </aside></div>
}
@Html.Partial("_PVSimilarProduct", Model)
</div>
@section scripts {
<script>
(function () {
    function update() {
        var total = 0;
        document.querySelectorAll('[data-cart-select]:checked').forEach(function (c) { total += Number(c.getAttribute('data-total')); });
        var target = document.getElementById('cart-selected-total');
        if (target) target.textContent = new Intl.NumberFormat('vi-VN').format(total) + ' đ';
    }
    document.querySelectorAll('[data-cart-select]').forEach(function (c) { c.addEventListener('change', update); });
    update();
}());
</script>
}
