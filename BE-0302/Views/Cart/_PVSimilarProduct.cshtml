@model BE_0302.Models.ViewModel.Cart
@using PagedList.Mvc
@if (Model.SimilarProducts != null && Model.SimilarProducts.Count > 0) {
    <h2 class="cart-category-title">Sản phẩm tương tự</h2>
    <div class="order-product-grid">@foreach (var product in Model.SimilarProducts) { @Html.Partial("~/Views/Shared/_ProductCard.cshtml", product) }</div>
    @Html.PagedListPager(Model.SimilarProducts, page => Url.Action("Index", "Cart", new { page }))
}
